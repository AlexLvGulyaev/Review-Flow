# PostgreSQL
POSTGRES_DB=reviewflow
POSTGRES_USER=reviewflow
POSTGRES_PASSWORD=reviewflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg2://reviewflow:reviewflow@postgres:5432/reviewflow

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8700

# Frontend → Backend
# For local development: http://localhost:8700
# For production deployment: https://review-flow-api.alex-n8n.site
VITE_API_URL=http://localhost:8700

# Production-only Traefik hosts (used by docker-compose.prod.yml)
REVIEW_FLOW_WEB_HOST=review-flow.alex-n8n.site
REVIEW_FLOW_ADMIN_HOST=review-flow-admin.alex-n8n.site
REVIEW_FLOW_API_HOST=review-flow-api.alex-n8n.site

# OpenAI (optional — empty = use DB-selected provider with fallback to mock)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ProxyAPI OpenAI-compatible
PROXYAPI_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1

# GigaChat (OAuth via GIGACHAT_AUTH_KEY or CLIENT_ID + CLIENT_SECRET)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Max
GIGACHAT_MAX_TOKENS=500

# Phrase matching threshold (0-100, rapidfuzz scale)
PHRASE_MATCH_THRESHOLD=55

# Controlled Hybrid pipeline (set false to restore legacy MVP pipeline)
CH_PIPELINE_ENABLED=true
CH_CONFIDENCE_MEDIUM_DELTA=0.10
CH_RETRIEVAL_TOP_N=5

# ──────────────────────────────────────────────────────────────
# Ops/admin console authentication (read-only demo RBAC)
# Generate three strong random tokens, e.g.:
#   openssl rand -hex 32
# When OPS_ADMIN_TOKEN is set (and not a YOUR_ placeholder), ops endpoints
# require a Bearer token and derive the role from it. When empty (local dev),
# the legacy X-Role header fallback is used.
# ──────────────────────────────────────────────────────────────
OPS_ADMIN_TOKEN=dev-admin-token
OPS_OPERATOR_TOKEN=dev-operator-token
OPS_DEMO_TOKEN=dev-demo-token

# Build-time demo token baked into the ops/admin console frontend. Must match
# OPS_DEMO_TOKEN above. Enables the read-only "Войти в демо-режим" button.
VITE_OPS_DEMO_TOKEN=dev-demo-token

# ──────────────────────────────────────────────────────────────
# Public Web UI demo sessions (tokenized demo limiter)
# When DEMO_LIMITER_ENABLED=true, POST /api/reviews requires an X-Demo-Token
# issued by POST /api/demo/start and consumes a per-session quota. Set false
# for local dev to leave the endpoint open.
# ──────────────────────────────────────────────────────────────
DEMO_LIMITER_ENABLED=false
DEMO_MAX_REQUESTS_PER_SESSION=20
DEMO_SESSION_TTL_MINUTES=30
DEMO_RATE_LIMIT_PER_MINUTE=12
DEMO_MAX_SESSIONS_PER_IP_PER_HOUR=5
